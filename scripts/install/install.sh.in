#!/bin/sh
# Generated by scripts/install/generate.py. Edit the template and copy.json.
# Permanent installer for the complete SafeRM desktop distribution.
# Message formats come from the checked-in copy catalog; arguments are never used as formats.
# shellcheck disable=SC2059
# Exact executable paths can contain regex characters; pgrep's regex matching is unsuitable here.
# shellcheck disable=SC2009
set -eu

@@MESSAGES@@

fail() { printf "$msg_error_prefix" "$*" >&2; exit 1; }

download() {
    if command -v curl >/dev/null; then
        curl -fSL --retry 3 --output "$2" "$1" || fail "$(printf "$msg_download_failed" "$1")"
    elif command -v wget >/dev/null; then
        wget -O "$2" "$1" || fail "$(printf "$msg_download_failed" "$1")"
    else
        fail "$msg_download_tool"
    fi
}

as_admin() {
    if [ "$(id -u)" = 0 ] || { [ "$system" = darwin ] && [ "$mac_needs_admin" = 0 ]; }; then "$@"
    elif command -v sudo >/dev/null; then sudo "$@"
    else fail "$msg_admin_required"
    fi
}

cleanup() {
    installer_status=$?
    trap - EXIT
    if [ -n "$mount_directory" ]; then hdiutil detach "$mount_directory" || installer_status=1; fi
    if [ -n "$staging_directory" ]; then
        # Restore the previous bundle if replacement failed before the new bundle was placed.
        if [ -d "$staging_directory/previous.app" ] && [ ! -e "$application_path" ]; then
            if ! as_admin mv "$staging_directory/previous.app" "$application_path"; then
                printf '%s\n' "$staging_directory/previous.app" >&2
                exit 1
            fi
        fi
        as_admin rm -rf "$staging_directory" || installer_status=1
    fi
    rm -rf "$download_directory" || installer_status=1
    exit "$installer_status"
}

install_macos() {
    [ "$(id -u)" != 0 ] || fail "$msg_mac_root"
    [ "$(sw_vers -productVersion | cut -d. -f1)" -ge 13 ] || fail "$msg_unsupported"
    applications_directory=${SAFERM_INSTALL_DIR:-/Applications}
    binaries_directory=${SAFERM_BIN_DIR:-/usr/local/bin}
    case "$applications_directory:$binaries_directory" in /*:/*) ;; *) fail "$msg_absolute_paths" ;; esac
    application_path="$applications_directory/SafeRM.app"
    cli_path="$binaries_directory/saferm"
    if [ -w "$applications_directory" ] && [ -w "$binaries_directory" ]; then mac_needs_admin=0; fi
    if [ -e "$cli_path" ] || [ -L "$cli_path" ]; then
        [ -L "$cli_path" ] && [ "$(readlink "$cli_path")" = "$application_path/Contents/MacOS/saferm" ] ||
            fail "$(printf "$msg_occupied_cli" "$cli_path")"
    fi
    if [ -e "$application_path" ]; then
        bundle_identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$application_path/Contents/Info.plist")
        [ "$bundle_identifier" = com.shdeen.saferm ] || fail "$(printf "$msg_occupied_app" "$application_path")"
        if ps -ax -o comm= | grep -Fx "$application_path/Contents/MacOS/saferm-app" >/dev/null; then fail "$msg_close_gui"; fi
    fi
    mkdir "$download_directory/mount"
    hdiutil attach "$package_path" -readonly -nobrowse -mountpoint "$download_directory/mount"
    mount_directory="$download_directory/mount"
    source_application="$mount_directory/SafeRM.app"
    codesign --verify --deep --strict "$source_application"
    test -x "$source_application/Contents/MacOS/saferm"
    test -x "$source_application/Contents/MacOS/saferm-app"
    test -x "$source_application/Contents/Library/LoginItems/SafeRM Notify.app/Contents/MacOS/saferm-notify"
    if [ ! -d "$applications_directory" ]; then as_admin mkdir -p "$applications_directory"; fi
    if [ ! -d "$binaries_directory" ]; then as_admin mkdir -p "$binaries_directory"; fi
    if [ -w "$applications_directory" ]; then
        staging_directory=$(mktemp -d "$applications_directory/.saferm-install.XXXXXX")
    else
        staging_directory=$(as_admin mktemp -d "$applications_directory/.saferm-install.XXXXXX")
    fi
    # Copy before touching the installed application; moving within this directory is a rename.
    as_admin ditto "$source_application" "$staging_directory/SafeRM.app"
    notifier_status=2
    notifier_path="$application_path/Contents/Library/LoginItems/SafeRM Notify.app/Contents/MacOS/saferm-notify"
    if [ -x "$notifier_path" ] && ps -ax -o comm= | grep -Fx "$notifier_path" >/dev/null; then
        "$notifier_path" --quit && notifier_status=0 || notifier_status=$?
    fi
    case "$notifier_status" in 0|2) ;; *) fail "$msg_notifier_stop" ;; esac
    if [ -d "$application_path" ]; then as_admin mv "$application_path" "$staging_directory/previous.app"; fi
    as_admin mv "$staging_directory/SafeRM.app" "$application_path"
    as_admin ln -sfn "$application_path/Contents/MacOS/saferm" "$cli_path"
    if [ "$notifier_status" = 0 ]; then
        open -g "$application_path/Contents/Library/LoginItems/SafeRM Notify.app" || printf '%s\n' "$msg_notifier_restart" >&2
    fi
}

main() {
    system=$(uname -s)
    architecture=$(uname -m)
    case "$system" in
        Darwin)
            system=darwin
            package_format=dmg
            # -i suppresses the absent optional key on Intel Macs without hiding other errors.
            if [ "$architecture" = x86_64 ]; then
                translated=$(/usr/sbin/sysctl -in sysctl.proc_translated)
                if [ "$translated" = 1 ]; then architecture=arm64; fi
            fi
            ;;
        Linux)
            system=linux
            if command -v apt-get >/dev/null; then package_format=deb
            elif command -v dnf >/dev/null; then package_format=rpm
            else fail "$msg_unsupported"
            fi
            ;;
        *) fail "$msg_unsupported" ;;
    esac
    case "$architecture" in x86_64|amd64) architecture=amd64 ;; aarch64|arm64) architecture=arm64 ;; *) fail "$msg_unsupported" ;; esac
    # /tmp is searchable by APT's restricted account even when HOME or TMPDIR is private.
    download_directory=$(mktemp -d /tmp/saferm-install.XXXXXX)
    mount_directory=
    staging_directory=
    mac_needs_admin=1
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    releases_url=https://github.com/shdeen/saferm/releases
    latest_url=https://api.github.com/repos/shdeen/saferm/releases/latest
    version=${SAFERM_VERSION:-}
    if [ -z "$version" ]; then
        download "$latest_url" "$download_directory/latest.json"
        version=$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$download_directory/latest.json")
    fi
    version=${version#v}
    printf '%s\n' "$version" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || fail "$msg_invalid_version"
    # grep is line-oriented; reject newlines even if one line happens to be a valid version.
    case "$version" in *'
'*) fail "$msg_invalid_version" ;; esac
    package_name="saferm_${version}_${system}_${architecture}.${package_format}"
    package_path="$download_directory/$package_name"
    download "$releases_url/download/v$version/$package_name" "$package_path"
    download "$releases_url/download/v$version/saferm_${version}_checksums.txt" "$download_directory/checksums.txt"
    expected_checksum=$(awk -v filename="$package_name" '$2 == filename { print $1 }' "$download_directory/checksums.txt")
    [ "${#expected_checksum}" = 64 ] || fail "$msg_checksum_failed"
    if command -v sha256sum >/dev/null; then actual_checksum=$(sha256sum "$package_path")
    elif command -v shasum >/dev/null; then actual_checksum=$(shasum -a 256 "$package_path")
    else fail "$msg_checksum_tool"
    fi
    [ "${actual_checksum%% *}" = "$expected_checksum" ] || fail "$msg_checksum_failed"
    printf "$msg_installing" "$version" "$system" "$architecture"
    if [ "$system" = darwin ]; then
        install_macos
    else
        chmod 755 "$download_directory"
        chmod 644 "$package_path"
        if [ "$package_format" = deb ]; then as_admin apt-get install --yes "$package_path" </dev/null
        else as_admin dnf install --assumeyes "$package_path" </dev/null
        fi
        cli_path=/usr/bin/saferm
        binaries_directory=/usr/bin
    fi
    "$cli_path" help >/dev/null
    printf "$msg_installed" "$version"
    resolved_cli=$(command -v saferm || true)
    if [ -z "$resolved_cli" ]; then printf "$msg_missing_path" "$binaries_directory"
    elif ! [ "$resolved_cli" -ef "$cli_path" ]; then printf "$msg_shadowed_path" "$resolved_cli" "$cli_path"
    fi
}

main
